# Copy this file to .env and fill in real values. Never commit .env itself.

# --- MongoDB Atlas ---
# Get this from Atlas -> Connect -> Drivers -> Python
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=social_media_studio

# --- App security ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace_with_a_long_random_secret
TOKEN_EXPIRY_MINUTES=60

# --- Webhook signing ---
WEBHOOK_SIGNING_SECRET=replace_with_another_long_random_secret

# --- X (Twitter) API credentials ---
# From developer.x.com -> your app -> Keys and tokens (OAuth 1.0a, user context)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Mock platform rate limiting ---
MOCK_PLATFORM_RATE_LIMIT=5
MOCK_PLATFORM_RATE_WINDOW_SECONDS=60
